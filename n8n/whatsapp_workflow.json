{
  "name": "DelhiCommuteBot WhatsApp Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Twilio Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "dcb-whatsapp-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-body",
              "name": "messageBody",
              "value": "={{ $json.body.Body }}",
              "type": "string"
            },
            {
              "id": "sender-phone",
              "name": "senderPhone",
              "value": "={{ $json.body.From }}",
              "type": "string"
            },
            {
              "id": "sender-name",
              "name": "senderName",
              "value": "={{ $json.body.ProfileName || 'User' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-variables",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw_text: $json.messageBody, user_phone: $json.senderPhone }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "api-request",
      "name": "Call DelhiCommuteBot API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-response",
              "leftValue": "={{ $json.response_text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-response",
      "name": "Check Response OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "={{ $env.TWILIO_WHATSAPP_NUMBER || 'whatsapp:+14155238886' }}",
        "to": "={{ $('Extract Message Data').item.json.senderPhone }}",
        "toNumber": "={{ $('Extract Message Data').item.json.senderPhone }}",
        "message": "={{ $json.response_text }}"
      },
      "id": "twilio-send-success",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1120, 200],
      "credentials": {
        "twilioApi": {
          "id": "TWILIO_CREDENTIALS_ID",
          "name": "Twilio Account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "={{ $env.TWILIO_WHATSAPP_NUMBER || 'whatsapp:+14155238886' }}",
        "to": "={{ $('Extract Message Data').item.json.senderPhone }}",
        "toNumber": "={{ $('Extract Message Data').item.json.senderPhone }}",
        "message": "Sorry, I encountered an error processing your request. Please try again in a moment.\n\nYou can ask me things like:\n- \"Bus from Kashmere Gate to Laxmi Nagar\"\n- \"Metro route to Rajiv Chowk\"\n- \"Auto fare from CP to Saket\""
      },
      "id": "twilio-send-error",
      "name": "Send Error Message",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1120, 420],
      "credentials": {
        "twilioApi": {
          "id": "TWILIO_CREDENTIALS_ID",
          "name": "Twilio Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response></Response>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/xml"
              }
            ]
          }
        }
      },
      "id": "webhook-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Twilio Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract Message Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Message Data": {
      "main": [
        [
          {
            "node": "Call DelhiCommuteBot API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call DelhiCommuteBot API": {
      "main": [
        [
          {
            "node": "Check Response OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response OK": {
      "main": [
        [
          {
            "node": "Send WhatsApp Reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Error Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Reply": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Error Message": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "DelhiCommuteBot",
      "createdAt": "2025-01-01T00:00:00.000Z",
      "updatedAt": "2025-01-01T00:00:00.000Z"
    }
  ],
  "triggerCount": 1,
  "updatedAt": "2025-01-01T00:00:00.000Z",
  "versionId": "1"
}
