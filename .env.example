# =============================================================================
# DelhiCommuteBot Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/delhicommutebot

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Optional: LLM API Key (if using LLM-based chains instead of rule-based) ---
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# --- App Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Model Paths ---
INTENT_MODEL_PATH=models/intent_classifier
FAISS_INDEX_PATH=data/indices
